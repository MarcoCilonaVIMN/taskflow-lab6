    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": { "express": "5.2.1" },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "@types/express": "5.0.6",
    "@types/node": "26.0.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "fast-check": "4.8.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
