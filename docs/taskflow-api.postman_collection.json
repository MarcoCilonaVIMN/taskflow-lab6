{
  "info": {
    "name": "TaskFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collezione per testare le API REST di TaskFlow (Node + Express). Base URL: http://localhost:3000"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Popolato automaticamente dopo POST /api/tasks"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET /api/tasks — lista completa",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Risposta è array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tasks?status=todo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=todo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "todo" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tutti i task hanno status todo', () => {",
                  "  pm.response.json().forEach(t => pm.expect(t.status).to.eql('todo'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tasks?status=in-progress",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=in-progress",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "in-progress" }]
            }
          }
        },
        {
          "name": "GET /api/tasks?status=done",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=done",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "done" }]
            }
          }
        },
        {
          "name": "GET /api/tasks?status=INVALID — 400",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=invalid",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "invalid" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Content-Type problem+json', () => pm.expect(pm.response.headers.get('content-type')).to.include('problem+json'));",
                  "pm.test('Campi RFC 9457', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.all.keys('type','title','status','detail');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/tasks — crea task",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Primo task di test\",\n  \"description\": \"Creato via Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Task ha id e status todo', () => {",
                  "  const t = pm.response.json();",
                  "  pm.expect(t.id).to.be.a('string');",
                  "  pm.expect(t.status).to.eql('todo');",
                  "  pm.expect(t.title).to.eql('Primo task di test');",
                  "  pm.collectionVariables.set('taskId', t.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/tasks — titolo vuoto 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Content-Type problem+json', () => pm.expect(pm.response.headers.get('content-type')).to.include('problem+json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/tasks — title assente 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Nessun titolo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/tasks/:id — cambia status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status aggiornato', () => pm.expect(pm.response.json().status).to.eql('in-progress'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/tasks/:id — aggiorna titolo",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Titolo aggiornato\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Titolo aggiornato', () => pm.expect(pm.response.json().title).to.eql('Titolo aggiornato'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/tasks/:id — status non valido 400",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"invalid-status\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Content-Type problem+json', () => pm.expect(pm.response.headers.get('content-type')).to.include('problem+json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/tasks/:id — id non trovato 404",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/id-inesistente",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Content-Type problem+json', () => pm.expect(pm.response.headers.get('content-type')).to.include('problem+json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /api/tasks/:id — elimina task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.test('Body vuoto', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /api/tasks/:id — id non trovato 404",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/id-inesistente"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Content-Type problem+json', () => pm.expect(pm.response.headers.get('content-type')).to.include('problem+json'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
